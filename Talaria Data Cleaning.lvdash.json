{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Cleaning KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM workspace.talaria.bronze_facilities) AS bronze_rows,\n",
        "  (SELECT COUNT(*) FROM workspace.talaria.silver_facilities_stage3) AS final_rows,\n",
        "  (SELECT COUNT(*) FROM workspace.talaria.bronze_facilities) - (SELECT COUNT(*) FROM workspace.talaria.silver_facilities_stage3) AS removed_rows,\n",
        "  (SELECT COUNT_IF(flag_unverified) FROM workspace.talaria.silver_facilities_stage3) AS unverified_rows"
      ]
    },
    {
      "name": "stages",
      "displayName": "Rows per cleaning stage",
      "queryLines": [
        "SELECT '01 · Bronze (raw)' AS stage, COUNT(*) AS row_count FROM workspace.talaria.bronze_facilities\n",
        "UNION ALL SELECT '02 · Silver Base (objective cleaning)', COUNT(*) FROM workspace.talaria.silver_facilities_base\n",
        "UNION ALL SELECT '03 · Silver Facilities (flags)', COUNT(*) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT '04 · Silver Stage 3 (rules)', COUNT(*) FROM workspace.talaria.silver_facilities_stage3"
      ]
    },
    {
      "name": "highlights",
      "displayName": "Major cleaning actions",
      "queryLines": [
        "SELECT * FROM VALUES\n",
        "  ('Literal \"null\" text → NULL (cells)', 54002),\n",
        "  ('URL format normalization (cells)', 171123),\n",
        "  ('UK → US spelling fixes (cells)', 31247),\n",
        "  ('specialties list dedup (items)', 160769),\n",
        "  ('phone number list dedup (items)', 56765),\n",
        "  ('website list dedup (items)', 33351),\n",
        "  ('state/city spelling fixes (rows)', 559),\n",
        "  ('PIN format normalization (rows)', 156)\n",
        "AS t(action, affected)"
      ]
    },
    {
      "name": "rule_log",
      "displayName": "Stage 3 rule log",
      "queryLines": [
        "SELECT rule_id, output_column, rows_flagged_or_remaining\n",
        "FROM workspace.talaria.silver_stage3_rule_counts"
      ]
    },
    {
      "name": "flags",
      "displayName": "Facilities per flag",
      "queryLines": [
        "SELECT 'A · Contact' AS grp, 'Official phone missing from list' AS flag, COUNT_IF(flag_official_phone_not_in_list) AS flagged FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'A · Contact', 'Phone list without official number', COUNT_IF(flag_phone_list_without_official) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'A · Contact', 'Official website missing from list', COUNT_IF(flag_official_website_not_in_list) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'B · Scale', 'Bed/doctor ratio outlier', COUNT_IF(flag_bed_doctor_ratio_outlier) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'C · Specialty', 'Specialty-capability mismatch', COUNT_IF(flag_specialty_unsupported_by_capability) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'D · Description', 'Description mentions another state', COUNT_IF(flag_desc_mentions_other_state) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'E · Affiliation', 'Affiliation-operator conflict', COUNT_IF(flag_affiliation_operator_conflict) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'F · Sources', 'Has government source', COUNT_IF(flag_has_government_source) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'F · Sources', 'Own site among sources', COUNT_IF(flag_own_site_in_sources) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'F · Sources', 'Directory sources only', COUNT_IF(flag_only_directory_sources) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'F · Sources', 'Single source domain', COUNT_IF(flag_single_source_domain) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'G · Page update', 'Page update date unparsable', COUNT_IF(flag_page_update_unparsable) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'G · Page update', 'Future page update date', COUNT_IF(flag_future_page_update) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'H · Location', 'Coords far from written PIN', COUNT_IF(flag_coords_far_from_written_pin) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'H · Location', 'No same-prefix PIN nearby', COUNT_IF(flag_no_same_prefix_pin_nearby) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'H · Location', 'Multiple facilities share coords', COUNT_IF(flag_coords_shared) FROM workspace.talaria.silver_facilities\n",
        "UNION ALL SELECT 'S3 · R0', 'Facility scale outlier (beds/doctors)', COUNT_IF(flag_facility_capacity_outlier) FROM workspace.talaria.silver_facilities_stage3\n",
        "UNION ALL SELECT 'S3 · F1', 'Name-facilityType mismatch', COUNT_IF(flag_name_facilityType) FROM workspace.talaria.silver_facilities_stage3\n",
        "UNION ALL SELECT 'S3 · C1', 'Unverified', COUNT_IF(flag_unverified) FROM workspace.talaria.silver_facilities_stage3\n",
        "UNION ALL SELECT 'S3 · C2', 'Partial data', COUNT_IF(flag_partial) FROM workspace.talaria.silver_facilities_stage3\n",
        "UNION ALL SELECT 'S3 · C3', 'Specialty unsupported', COUNT_IF(flag_specialty_unsupported) FROM workspace.talaria.silver_facilities_stage3\n",
        "UNION ALL SELECT 'S3 · C4', 'Major field orphan', COUNT_IF(flag_major_orphan) FROM workspace.talaria.silver_facilities_stage3\n",
        "UNION ALL SELECT 'S3 · C5', 'Parallel-category mismatch', COUNT_IF(flag_merge_different) FROM workspace.talaria.silver_facilities_stage3"
      ]
    },
    {
      "name": "ops_log",
      "displayName": "Operations by stage (pipeline step logs)",
      "queryLines": [
        "-- per-stage operations, live from the pipeline step logs\n",
        "SELECT '02 · Silver Base' AS stage, section AS detail, label AS action, `count` AS operations,\n",
        "  CASE section WHEN 'rows' THEN 'rows' WHEN 'items_removed' THEN 'items' WHEN 'flags' THEN 'facilities' ELSE 'cells' END AS unit\n",
        "FROM workspace.talaria_pipeline.silver_base_step_log\n",
        "UNION ALL\n",
        "SELECT '03 · Silver Facilities', `group`, flag, flagged, 'facilities'\n",
        "FROM workspace.talaria_pipeline.silver_facilities_flag_log\n",
        "UNION ALL\n",
        "SELECT '05 · Stage 3', rule_id, output_column, rows_flagged_or_remaining, 'rows'\n",
        "FROM workspace.talaria_pipeline.silver_stage3_rule_counts\n",
        "WHERE output_column NOT IN ('outlier_reason', 'large_hospital_step_failed')"
      ]
    },
    {
      "name": "gold_kpis",
      "displayName": "Gold scoring KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM workspace.talaria_pipeline.gold_facilities) AS gold_rows,\n",
        "  (SELECT ROUND(AVG(confidence_score), 2) FROM workspace.talaria_pipeline.gold_facilities) AS avg_score,\n",
        "  (SELECT COUNT_IF(location_uncertain) FROM workspace.talaria_pipeline.gold_facilities) AS location_uncertain,\n",
        "  (SELECT COUNT_IF(needs_investigation) FROM workspace.talaria_pipeline.gold_facilities) AS needs_investigation,\n",
        "  (SELECT COUNT(*) FROM workspace.talaria.bronze_facilities) - (SELECT COUNT(*) FROM workspace.talaria_pipeline.gold_facilities) AS dropped_rows\n"
      ]
    },
    {
      "name": "score_dist",
      "displayName": "Confidence score distribution",
      "queryLines": [
        "SELECT confidence_score, facilities FROM workspace.talaria_pipeline.gold_score_distribution\n",
        "ORDER BY confidence_score"
      ]
    },
    {
      "name": "worst_tiers",
      "displayName": "Facilities per worst tier",
      "queryLines": [
        "SELECT tier, facilities FROM workspace.talaria_pipeline.gold_worst_tier_log"
      ]
    },
    {
      "name": "rule_fires",
      "displayName": "Scoring rules fired (Gold)",
      "queryLines": [
        "SELECT tier, rule, reason, fired FROM workspace.talaria_pipeline.gold_rule_fire_log\n",
        "ORDER BY fired DESC"
      ]
    }
  ],
